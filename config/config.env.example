# Variables opcionales para ejecutar SIN preguntas:   set -a; . config/config.env; set +a; ./install.sh --non-interactive
# Copia este archivo a config/config.env (está en .gitignore) y rellénalo. NO subas claves a Git.

# --- Lo único realmente imprescindible ---------------------------------------------------------------
CCX_ENTITLEMENT_KEY=            # myibm.ibm.com/products-services/containerlibrary  (clave de acceso a cp.icr.io)
CCX_WXAI_API_KEY=               # API key de IBM Cloud cuyo Service ID es colaborador del deployment space
CCX_WXAI_URL=https://us-south.ml.cloud.ibm.com   # endpoint regional de watsonx.ai
CCX_WXAI_SPACE_ID=              # GUID del deployment space
CCX_WXAI_PROJECT_ID=            # opcional
CCX_WXAI_MODEL_ID=openai/gpt-oss-120b
CCX_ACCEPT_LICENSE=             # escribe 'yes' SOLO si aceptas la licencia de IBM (https://ibm.biz/CPE_CCx_License_26_0_1)

# --- Opcionales (valores por defecto entre paréntesis) ---------------------------------------------
# NS=ibm-content                          # namespace de Content Cortex
# AUTH_NS=ibm-auth                        # namespace de OpenLDAP + Keycloak (laboratorio)
# LICENSE_METRIC=CCx.Pre.AU               # Premium Authorized User (otras: CCx.Pre.EP, CCx.Pre.PE)
# BLOCK_SC=ocs-storagecluster-ceph-rbd    # StorageClass RWO (bases de datos)
# FILE_SC=ocs-storagecluster-cephfs       # StorageClass RWX (volúmenes compartidos)
# CCX_AI_PACKAGE=/ruta/ICCXAIST_26.0.1_ML.zip   # paquete de AI Services (descarga manual, fase 07)
# IBM_REPO_REF=26.0.1                     # rama del repo de IBM (== tag v26.1.0)
# HELM_VERSION=v4.1.1
